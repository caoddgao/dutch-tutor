          "options": [
            {
              "nl": "Glas.",
              "zh": "玻璃。",
              "en": "Glass."
            },
            {
              "nl": "Papier.",
              "zh": "废纸。",
              "en": "Paper."
            },
            {
              "nl": "Groen afval.",
              "zh": "绿色垃圾。",
              "en": "Green waste."
            }
