      "items": [
        {
          "id": "NN44-O2-1",
          "question": {
            "nl": "Hoe bevalt het in Nederland?",
            "zh": "您在荷兰过得怎么样？",
            "en": "How do you like it in the Netherlands?"
          },
          "sample_answers": [
            {
              "nl": "Prima, maar het weer is lastig.",
              "zh": "挺好，就是天气不好适应。",
              "en": "Fine, but the weather is difficult."
            },
            {
              "nl": "Het bevalt me goed.",
              "zh": "我很喜欢这里。",
              "en": "I like it a lot."
            }
          ]
        }
      ]
    },
    {
      "id": "NN44-R1",
      "type": "read_passage",
      "instruction": {
        "nl": "Lees de tekst en kies het goede antwoord.",
        "zh": "读短文，选择正确答案。",
        "en": "Read the text and choose the correct answer."
      },
      "passage": [
        {
          "nl": "Vanaf maandag 5 januari haalt de gemeente het afval op nieuwe dagen op.",
          "zh": "从 1 月 5 日星期一起，市政府改在新的日子收垃圾。",
          "en": "From Monday 5 January the municipality collects the waste on new days."
        },
        {
          "nl": "Groen afval halen we op dinsdag.",
          "zh": "绿色垃圾（厨余和园艺垃圾）星期二收。",
          "en": "We collect green waste on Tuesday."
        },
        {
          "nl": "Papier halen we op donderdag.",
          "zh": "废纸星期四收。",
          "en": "We collect paper on Thursday."
        },
        {
          "nl": "Glas halen we op vrijdag.",
          "zh": "玻璃星期五收。",
          "en": "We collect glass on Friday."
        },
        {
          "nl": "Zet uw afval voor 7.30 uur buiten.",
          "zh": "请在 7:30 以前把垃圾放到门外。",
          "en": "Put your waste outside before 7.30."
        },
        {
          "nl": "Gemeente Rotterdam",
          "zh": "鹿特丹市政府",
          "en": "Municipality of Rotterdam"
        }
      ],
      "items": [
        {
          "id": "NN44-R1-1",
          "question": {
            "nl": "Op welke dag haalt de gemeente papier op?",
            "zh": "市政府星期几收废纸？",
            "en": "On which day does the municipality collect paper?"
          },
          "options": [
            {
              "nl": "Op donderdag.",
              "zh": "星期四。",
              "en": "On Thursday."
            },
            {
              "nl": "Op dinsdag.",
              "zh": "星期二。",
              "en": "On Tuesday."
            },
            {
              "nl": "Op vrijdag.",
              "zh": "星期五。",
              "en": "On Friday."
            }
          ],
          "answer": "Op donderdag."
        },
        {
          "id": "NN44-R1-2",
          "question": {
            "nl": "Wat haalt de gemeente op vrijdag op?",
            "zh": "市政府星期五收什么？",
            "en": "What does the municipality collect on Friday?"
