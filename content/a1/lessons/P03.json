    },
    {
      "id": "P03-S05",
      "nl": "Waar is mijn sok?",
      "zh": "我的袜子在哪儿？",
      "en": "Where is my sock?"
    },
    {
      "id": "P03-S06",
      "nl": "De bus is vol.",
      "zh": "公交车满了。",
      "en": "The bus is full."
    },
    {
      "id": "P03-S07",
      "nl": "Het is druk in de bus.",
      "zh": "公交车上人很多。",
      "en": "It is crowded on the bus."
    },
    {
      "id": "P03-S08",
      "nl": "Pas op, een mug!",
      "zh": "小心，有蚊子！",
      "en": "Watch out, a mosquito!"
    }
  ],
