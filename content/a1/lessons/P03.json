{
  "$schema": "../../schema/own-lesson.schema.json",
  "id": "P03",
  "kind": "phonics",
  "title": {
    "nl": "o · u",
    "zh": "短元音 o、u",
    "en": "Short vowels o, u"
  },
  "nn_lessons": ["NN06"],
  "sounds": [
    {
      "grapheme": "o",
      "note_zh": "短 o：嘴张开、嘴唇稍圆，像汉语“哦”，但更短，口形不动，一发就收。一个 o 后面跟辅音时读短音：kop、sok、pot、vol。",
      "note_en": "Short o: mouth open, lips slightly rounded — a short 'o' as in British 'pot'.",
      "word_ids": ["w_kop", "w_sok", "w_pot", "w_vol"]
    },
    {
      "grapheme": "u",
      "note_zh": "短 u：最容易读错的音。嘴唇轻轻拢圆，舌头放平、放松，发一个短促的“呃”。不是汉语的“乌”，也不是英语 bus 里的音：bus、mug、druk。",
      "note_en": "Short u: lips lightly rounded, tongue relaxed — a short rounded 'uh'. Not 'oo', and not the vowel of English 'bus'.",
      "word_ids": ["w_bus", "w_mug", "w_druk"]
    },
    {
      "grapheme": "a",
      "note_zh": "复习短 a：tas ↔ kop ↔ bus，只换中间的元音，意思就全变了。三个都是短音，一发就收，别拖长。",
      "note_en": "Review short a: tas ↔ kop ↔ bus — only the vowel changes. All three are short.",
      "word_ids": ["w_tas"]
    }
  ],
  "word_ids": ["w_kop", "w_sok", "w_pot", "w_vol", "w_bus", "w_mug", "w_druk", "w_tas", "w_pas_op"],
  "sentences": [
    {
      "id": "P03-S01",
      "nl": "Een kop thee?",
      "zh": "来杯茶吗？",
      "en": "A cup of tea?"
    },
    {
      "id": "P03-S02",
      "nl": "Ja, een kop thee, graag.",
      "zh": "好的，请来杯茶。",
      "en": "Yes, a cup of tea, please."
    },
    {
