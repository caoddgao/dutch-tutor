  "sentences": [
    {
      "id": "NN27-A01",
      "nl": "Ik ga vroeg uit bed.",
      "zh": "我很早起床。",
      "en": "I get out of bed early."
    },
    {
      "id": "NN27-A02",
      "nl": "Eerst ga ik douchen.",
      "zh": "我先洗澡。",
      "en": "First I take a shower."
    },
    {
      "id": "NN27-A03",
      "nl": "Ik luister naar het nieuws.",
      "zh": "我听新闻。",
      "en": "I listen to the news."
    },
    {
      "id": "NN27-A04",
      "nl": "Ik ben moe.",
      "zh": "我累了。",
      "en": "I am tired."
    }
  ],
  "exercises": [
    {
      "id": "NN27-O1",
      "type": "oral_complete",
      "instruction": {
        "nl": "Maak de zin af.",
        "zh": "听情景，把句子说完整。",
        "en": "Listen to the situation and finish the sentence aloud."
      },
      "items": [
        {
          "id": "NN27-O1-1",
          "context": {
            "nl": "Het is zeven uur. U bent nog moe.",
            "zh": "七点了，您还很累。",
            "en": "It is seven o'clock. You are still tired."
          },
          "start": {
            "nl": "Ik ga ...",
            "zh": "我……",
            "en": "I ..."
          },
          "sample_answers": [
            {
              "nl": "Ik ga nog niet uit bed.",
              "zh": "我还不起床。",
              "en": "I'm not getting out of bed yet."
            }
          ]
        }
      ]
    },
    {
      "id": "NN27-O2",
      "type": "oral_answer",
      "instruction": {
        "nl": "Geef antwoord.",
        "zh": "听问题，开口回答。",
        "en": "Answer the question aloud."
      },
      "items": [
        {
          "id": "NN27-O2-1",
          "question": {
            "nl": "Hoe laat gaat u 's ochtends uit bed?",
            "zh": "您早上几点起床？",
            "en": "What time do you get out of bed in the morning?"
          },
          "sample_answers": [
            {
              "nl": "Ik ga om zeven uur uit bed.",
              "zh": "我七点起床。",
              "en": "I get out of bed at seven o'clock."
            },
            {
              "nl": "Om half zeven.",
              "zh": "六点半。",
              "en": "At half past six."
            }
          ]
        }
      ]
    }
  ]
