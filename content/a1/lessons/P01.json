{
  "$schema": "../../schema/own-lesson.schema.json",
  "id": "P01",
  "kind": "phonics",
  "title": {
    "nl": "a · e · i",
    "zh": "短元音 a、e、i",
    "en": "Short vowels a, e, i"
  },
  "nn_lessons": ["NN05"],
  "sounds": [
    {
      "grapheme": "a",
      "note_zh": "短 a：嘴张大，声音短促，比汉语“啊”更短、更靠后。写一个 a、后面跟辅音时读短音：kam、bal、man。",
      "note_en": "Short a: open mouth, short and a bit further back than English 'father'. One a before a consonant is short.",
      "word_ids": ["w_kam", "w_bal", "w_man", "w_dag"]
    },
    {
      "grapheme": "e",
      "note_zh": "短 e：像汉语“哎”的开头，嘴角略向两边拉，一发就收：mes、bel、pen。",
      "note_en": "Short e: like the e in English 'bed', cut short.",
      "word_ids": ["w_mes", "w_bel", "w_pen"]
    },
    {
      "grapheme": "i",
      "note_zh": "短 i：比汉语“衣”更短、更松，接近英语 sit 里的 i：kip、lip、ik。",
      "note_en": "Short i: like the i in English 'sit', short and relaxed.",
      "word_ids": ["w_kip", "w_lip", "w_ik"]
    }
  ],
  "word_ids": [
    "w_dag",
    "w_kam",
    "w_bal",
    "w_man",
    "w_mes",
    "w_bel",
    "w_pen",
