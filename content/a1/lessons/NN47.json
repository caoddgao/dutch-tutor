      "items": [
        {
          "id": "NN47-O2-1",
          "question": {
            "nl": "Wat vindt u het leukst aan uw werk?",
            "zh": "您觉得工作里最有意思的是什么？",
            "en": "What do you like best about your work?"
          },
          "sample_answers": [
            {
              "nl": "Het leukst vind ik mijn collega's.",
              "zh": "我觉得最好的是我的同事。",
              "en": "What I like best are my colleagues."
            },
            {
              "nl": "Ik werk graag met mensen.",
              "zh": "我喜欢和人打交道。",
              "en": "I like working with people."
            }
          ]
        }
      ]
