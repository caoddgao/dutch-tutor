      "instruction": {
        "nl": "Lees de tekst en kies het goede antwoord.",
        "zh": "读短文，选择正确答案。",
        "en": "Read the text and choose the correct answer."
      },
      "passage": [
        {
          "nl": "Bedrijf Jansen zoekt een schilder.",
          "zh": "扬森公司招聘一名油漆工。",
          "en": "The Jansen company is looking for a painter."
        },
        {
          "nl": "U werkt op maandag, dinsdag en donderdag; op woensdag en vrijdag bent u vrij.",
          "zh": "星期一、二、四上班；星期三和星期五休息。",
          "en": "You work on Monday, Tuesday and Thursday; on Wednesday and Friday you are free."
        },
        {
          "nl": "Het werk begint om 7.30 uur en is om 16.00 uur klaar.",
          "zh": "工作 7:30 开始，16:00 结束。",
          "en": "Work starts at 7.30 and finishes at 16.00."
        },
        {
          "nl": "Van 12.00 tot 12.30 uur is er pauze.",
          "zh": "12:00 到 12:30 休息。",
          "en": "There is a break from 12.00 to 12.30."
        },
        {
          "nl": "U heeft ervaring als schilder.",
          "zh": "您要有油漆工的工作经验。",
          "en": "You have experience as a painter."
        },
        {
          "nl": "U kunt meneer Jansen bellen: 06-12345678.",
          "zh": "可以打电话给扬森先生：06-12345678。",
          "en": "You can call Mr Jansen: 06-12345678."
        }
      ],
      "items": [
        {
          "id": "NN47-R1-1",
          "question": {
            "nl": "Op welke dag werkt de schilder?",
            "zh": "油漆工哪天上班？",
            "en": "On which day does the painter work?"
          },
          "options": [
            {
              "nl": "Op dinsdag.",
              "zh": "星期二。",
              "en": "On Tuesday."
            },
            {
              "nl": "Op woensdag.",
              "zh": "星期三。",
              "en": "On Wednesday."
            },
            {
              "nl": "Op vrijdag.",
              "zh": "星期五。",
              "en": "On Friday."
            }
          ],
          "answer": "Op dinsdag."
        },
        {
          "id": "NN47-R1-2",
          "question": {
            "nl": "Hoe laat is het werk klaar?",
            "zh": "工作几点结束？",
            "en": "What time does work finish?"
          },
          "options": [
            {
              "nl": "Om 16.00 uur.",
              "zh": "16:00。",
              "en": "At 16.00."
            },
            {
              "nl": "Om 7.30 uur.",
              "zh": "7:30。",
              "en": "At 7.30."
            },
            {
              "nl": "Om 12.30 uur.",
              "zh": "12:30。",
              "en": "At 12.30."
