  "id": "P06",
  "kind": "phonics",
  "title": {
    "nl": "ij · ei · eu · ou · au",
    "zh": "ij/ei、eu、ou/au",
    "en": "ij/ei, eu, ou/au"
  },
  "nn_lessons": ["NN09", "NN10"],
  "reading": "NN15",
  "sounds": [
    {
      "grapheme": "ij · ei",
      "note_zh": "ij 和 ei 读音一样，像拼音的 ei（“黑”hēi 的韵母），开口稍大一点，介于 ai 和 ei 之间。只是写法不同，要按词记：vijf、tijd 写 ij，geit 写 ei。",
      "note_en": "ij and ei sound the same, close to pinyin 'ei' opened a little wider. Which spelling a word uses has to be learned.",
      "word_ids": ["w_vijf", "w_tijd", "w_geit"]
    },
    {
      "grapheme": "eu",
      "note_zh": "eu：舌头摆成发“诶”的样子，同时把嘴唇拢圆，口形不滑动。汉语里没有这个音，可以想成“圆唇的诶”：neus、leuk、deur、euro。",
      "note_en": "eu: tongue as for 'ay', lips rounded at the same time, no glide (like German ö).",
      "word_ids": ["w_neus", "w_leuk", "w_deur", "w_euro"]
    },
    {
      "grapheme": "ou · au",
      "note_zh": "ou 和 au 读音一样，像汉语“奥”（ao），但开头嘴张得小一点，结尾嘴唇收圆。词尾的 w 不单独发音：vrouw、koud 写 ou，blauw 写 au。",
      "note_en": "ou and au sound the same, like Mandarin 'ao' (奥) starting a little more closed; a final w is silent.",
      "word_ids": ["w_vrouw", "w_koud", "w_blauw"]
    }
  ],
  "word_ids": [
