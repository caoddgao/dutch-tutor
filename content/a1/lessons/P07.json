{
  "$schema": "../../schema/own-lesson.schema.json",
  "id": "P07",
  "kind": "phonics",
  "title": {
    "nl": "g · ch · sch · ng · r · v · w",
    "zh": "辅音 g/ch、sch、ng、r、v/w",
    "en": "Consonants g/ch, sch, ng, r, v/w"
  },
  "nn_lessons": ["NN09", "NN10"],
  "reading": "NN16",
  "sounds": [
    {
      "grapheme": "g · ch",
      "note_zh": "g 和 ch 读同一个音：喉咙后部摩擦出来的气流，像汉语“喝”的 h，但更靠后、摩擦更重，有点像轻轻清嗓子。不读成英语的 g：lachen、gezicht、glas、achternaam。",
      "note_en": "g and ch are the same sound: a rasping 'h' at the back of the throat (as in Scottish 'loch'), never English g.",
      "word_ids": ["w_lachen", "w_gezicht", "w_glas", "w_achternaam"]
    },
    {
      "grapheme": "sch",
      "note_zh": "sch：先发 s，紧接着上面的 g/ch 摩擦音，读成“s + 喝”。不是英语的 sh：school、schaar、schrift。",
      "note_en": "sch: s followed straight away by the throaty ch — not English 'sh'.",
      "word_ids": ["w_school", "w_schaar", "w_schrift"]
    },
    {
      "grapheme": "ng",
      "note_zh": "ng：就是拼音 -ng 的音（“行”xíng 的结尾），g 不单独发出来：ring、lang。",
      "note_en": "ng: like pinyin final -ng; the g is not pronounced on its own.",
      "word_ids": ["w_ring", "w_lang"]
    },
    {
      "grapheme": "r",
      "note_zh": "r：词首的 r 可以用舌尖轻弹一下，也可以用喉咙发，两种都对，选一种练顺。词尾的 r 很轻，接近英语的 r：raam、rood、deur。",
      "note_en": "r: at the start a tapped tongue-tip r or a throaty r — both are fine. At the end of a word it is soft.",
      "word_ids": ["w_raam", "w_rood"]
    },
    {
      "grapheme": "v · w",
      "note_zh": "v：标准读法是轻的浊音 v；荷兰很多人说得接近 f，两种都会听到。w：上齿轻碰下唇，嘴唇不撮圆，介于 v 和英语的 w 之间：water、werken、vrouw。",
      "note_en": "v: the standard sound is a light voiced v; many Dutch speakers say it close to f, you will hear both. w: upper teeth lightly touch the lower lip, lips not rounded.",
      "word_ids": ["w_water", "w_werken", "w_vrouw"]
    }
  ],
