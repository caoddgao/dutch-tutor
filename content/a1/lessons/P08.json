  "id": "P08",
  "kind": "phonics",
  "title": {
    "nl": "st · sp · br · tr · pl",
    "zh": "辅音连读",
    "en": "Consonant clusters"
  },
  "nn_lessons": ["NN11", "NN12", "NN13"],
  "reading": "NN17",
  "sounds": [
    {
      "grapheme": "st · sp",
      "note_zh": "词首的 st、sp：两个辅音紧挨着读，中间不加元音。不要读成“斯-他普”，要一口气读出 stap。spelen、spreken、stuur 也一样。",
      "note_en": "st, sp at the start: no vowel between the consonants — 'stap', not 'sutap'.",
      "word_ids": ["w_stap", "w_spelen", "w_stuur", "w_spreken"]
    },
    {
      "grapheme": "br · tr · pl · dr",
      "note_zh": "br、tr、pl、dr：r、l 紧跟在前面的辅音后面，一起读：broer、trein、plein、drinken。荷兰语的 p、t、k 不送气，比汉语的 p、t、k 轻，更接近汉语的 b、d、g。",
      "note_en": "br, tr, pl, dr are said together. Dutch p, t, k are not aspirated — closer to Mandarin b, d, g.",
      "word_ids": ["w_broer", "w_trein", "w_plein", "w_drinken", "w_trouwen"]
    },
    {
      "grapheme": "-lp · -ns · -d",
      "note_zh": "词尾的辅音要读清楚、后面不加元音：help 不读成“哈尔普”，les、sap、pil 干脆收住。词尾的 d 读成 t：bloed 听起来是 bloet，goed 也一样。",
      "note_en": "Final consonants are clear, with no vowel after them. A final d sounds like t: bloed sounds like 'bloet'.",
      "word_ids": ["w_helpen", "w_dansen", "w_bloed", "w_les", "w_sap", "w_pil"]
    }
  ],
