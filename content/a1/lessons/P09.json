    {
      "id": "P09-S03",
      "nl": "Wat is uw nummer?",
      "zh": "您的号码是多少？",
      "en": "What is your number?"
    },
    {
      "id": "P09-S04",
      "nl": "Mijn huisnummer is twaalf.",
      "zh": "我的门牌号是十二号。",
      "en": "My house number is twelve."
    },
    {
      "id": "P09-S05",
      "nl": "Ik ben twintig jaar.",
      "zh": "我二十岁。",
      "en": "I am twenty years old."
    },
    {
      "id": "P09-S06",
      "nl": "Het kost zeven euro.",
