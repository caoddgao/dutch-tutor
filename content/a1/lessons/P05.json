  "id": "P05",
  "kind": "phonics",
  "title": {
    "nl": "oe · ie · ui",
    "zh": "oe、ie、ui",
    "en": "oe, ie, ui"
  },
  "nn_lessons": ["NN07"],
  "reading": "NN14",
  "sounds": [
    {
      "grapheme": "oe",
      "note_zh": "oe：读汉语的“乌”（u），嘴唇撮圆往前。两个字母读一个音，不是“哦-诶”：voet、doel、boek、goed。",
      "note_en": "oe: Mandarin 'u' (乌), lips rounded and pushed forward — one sound, not two.",
      "word_ids": ["w_voet", "w_doel", "w_boek", "w_goed"]
    },
    {
      "grapheme": "ie",
      "note_zh": "ie：读汉语的“衣”（i），比 P01 的短 i（kip）更紧、更清楚。ie 一般不拉长，只在 r 前面拉长（hier）：riem、wiel、fiets。",
      "note_en": "ie: Mandarin 'i' (衣), tenser than the short i in kip; long only before r (hier).",
      "word_ids": ["w_riem", "w_wiel", "w_fiets", "w_hier"]
    },
    {
      "grapheme": "ui",
      "note_zh": "ui：荷兰语特有的音，不能按拼音读成“威”。先发圆唇的“呃”（嘴张开一点、嘴唇拢圆），再滑向 ü（鱼）。练法：说“哎”时把嘴唇拢圆：huis、thuis、duim。",
      "note_en": "ui: a typically Dutch diphthong — start with a rounded 'uh' and glide to ü. Not like pinyin 'ui' (wei).",
      "word_ids": ["w_huis", "w_thuis", "w_duim"]
    }
  ],
