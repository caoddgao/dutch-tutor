{
  "$schema": "../../schema/own-lesson.schema.json",
  "id": "P04",
  "kind": "phonics",
  "title": {
    "nl": "oo · uu",
    "zh": "长元音 oo、uu",
    "en": "Long vowels oo, uu"
  },
  "nn_lessons": ["NN08"],
  "sounds": [
    {
      "grapheme": "oo",
      "note_zh": "长 oo：嘴唇圆，把“哦”拉长，结尾嘴唇再收一点，略带 u 的滑音，有点像汉语“欧”。写两个 o 就读长音。对比：zon（太阳）↔ zoon（儿子）。",
      "note_en": "Long oo: rounded lips, a long 'oh' with a slight glide towards 'oo'. Compare zon (sun) and zoon (son).",
      "word_ids": ["w_noot", "w_rood", "w_zoon"]
    },
    {
      "grapheme": "uu",
      "note_zh": "长 uu：就是汉语拼音的 ü（“鱼”的韵母）拉长：嘴唇撮圆，舌头的位置和发“衣”一样。对比短 u：bus 短而松，vuur、duur 长而紧。",
      "note_en": "Long uu: Mandarin ü (as in 鱼 yú), held long. Compare the short, relaxed u in bus.",
      "word_ids": ["w_vuur", "w_uur", "w_duur"]
    },
    {
      "grapheme": "aa · ee",
      "note_zh": "复习长 aa、ee：jaar 的 aa 是拉长的“啊”；zeep、geel 的 ee 是拉长的“诶”，结尾略带 i。拼写规律：音节以元音结尾时，一个字母也读长音，所以复数写 jaren、zepen。",
      "note_en": "Review long aa and ee. In an open syllable one letter is long too: jaren, zepen.",
      "word_ids": ["w_jaar", "w_zeep", "w_geel"]
    }
  ],
  "word_ids": ["w_noot", "w_rood", "w_zoon", "w_vuur", "w_uur", "w_duur", "w_jaar", "w_zeep", "w_geel", "w_wonen"],
