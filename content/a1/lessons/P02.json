  "id": "P02",
  "kind": "phonics",
  "title": {
    "nl": "aa · ee",
    "zh": "长元音 aa、ee",
    "en": "Long vowels aa, ee"
  },
  "sounds": [
    {
      "grapheme": "aa",
      "note_zh": "长 aa：嘴张大，把“啊”拉长，口形不变。写成两个 a 就读长音。对比：man（男人）↔ maan（月亮）。",
      "note_en": "Long aa: an open, long 'ah'. Compare man (man) and maan (moon).",
      "word_ids": ["w_naam", "w_maan", "w_taal"]
    },
    {
      "grapheme": "ee",
      "note_zh": "长 ee：像汉语“诶”拉长，结尾嘴角往两边、略带一点 i 的滑音。对比：bel ↔ twee。",
      "note_en": "Long ee: a long 'ay' with a slight glide at the end. Compare bel and twee.",
      "word_ids": ["w_twee", "w_nee", "w_thee"]
    }
  ],
  "word_ids": [
